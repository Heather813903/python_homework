def average_customer_order_price(cursor):
    query = """
    SELECT
        c.customer_name,
        AVG(order_totals.total_price) AS average_total_price
        FROM customers c
        LEFT JOIN (
            SELECT
                o.customer_id AS customer_id_b,
                SUM(p.price * l.quantity) AS total_price
            FROM orders o 
            JOIN line_items l ON o.order_id = l.order_id
            JOIN products p ON l.product_id = p.product_id
            GROUP BY o.order_id
    )   AS order_totals
    ON c.customer_id = order_totals.customer_id_b
    GROUP BY c.customer_id;

"""  
    cursor.execute(query)
    results = cursor.fetchall()
    print("\nTask 2: Average Customer Order Price")
    print("Customer Name | Average Total Price")
    print("-----------------------------------")
    for name, avg_price in results:
        if avg_price:
            print(f"{name:<16} | ${avg_price:.2f}")
        else:
            print(f"{name:<16} | No orders")

